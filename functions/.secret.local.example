# Local secrets for the Firebase Functions emulator.
#
# `yarn dev:local` copies this file to functions/.secret.local (gitignored) on
# first run. Values in .secret.local are used by the emulator instead of
# Google Cloud Secret Manager. Never put real keys in this .example file.

# Required for the AI features (generate subtasks, suggest priority / due date,
# enhance description). Replace "placeholder" with a key from
# https://platform.claude.com/settings/keys
#
# Keep every value non-empty: the emulator treats a blank value as "not set"
# and tries Google Cloud Secret Manager instead, which logs a red error. The
# word "placeholder" is recognised by the functions as "not configured".
ANTHROPIC_API_KEY=placeholder

# Optional: only needed to exercise these integrations locally. They stay
# disabled (with a clear error) while set to "placeholder".
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
NODEMAILER_SMTP_PASSWORD=placeholder
GITHUB_APP_ID=placeholder
GITHUB_APP_PRIVATE_KEY=placeholder
GITHUB_CLIENT_ID=placeholder
GITHUB_CLIENT_SECRET=placeholder
GITHUB_WEBHOOK_SECRET=placeholder
